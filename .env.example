# AI 프로바이더 (필요한 것만 채우기)
# 사용 가능한 프로바이더: openai | anthropic | zhipu | moonshot | minimax
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
ZAI_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=

# 기본 프로바이더 (위 5개 중 하나)
DEFAULT_AI_PROVIDER=openai

# ElevenLabs (음성 클론 + TTS)
ELEVENLABS_API_KEY=sk_
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# 파이프라인 경로 (기본: 현재 디렉토리)
PIPELINE_PROJ_DIR=

# 음성 설정
DEFAULT_VOICE=main
DEFAULT_SPEED=1.1
